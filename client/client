#!/usr/bin/env bash
# Wrapper for the Zappy autonomous AI client.
# Invoked as ./client/client (root ./client conflicts with client/ on Unix).
# C01: real CLI + TCP connect + handshake (zappy_client package).
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Run the package as a module; no shell `exec` of another process image is
# required and none of the server's forbidden exec* usage applies here.
PYTHONPATH="${ROOT}${PYTHONPATH:+:${PYTHONPATH}}" exec python3 -m zappy_client "$@"
